# BYTE-EXACT OR NOTHING.
# core.autocrlf=true on Windows silently rewrote FABLE5-SEE-SELF-64.hbp from 1142 B
# to 1155 B - one CRLF per row on a 13-row receipt - which broke its own sha256
# sidecar. The .gguf and .hbi were protected as binary; .hbp and .sha256 were not.
# Binary tensors remain -text. Text receipts, law books, and checksum sidecars are
# canonical LF on every seat so their committed bytes and SHA-256 proofs agree.
* -text
*.md    text eol=lf
*.hbp   text eol=lf
*.hbi   -text
*.sha256 text eol=lf
.gitattributes text eol=lf
receipts/LIRIS-*.hbi text eol=lf
*.gguf  -text binary
*.png   -text binary
*.wasm  -text binary
*.raw   -text binary
*.bin   -text binary
*.qr    -text binary

# New Liris publication surfaces have one canonical LF representation. Historical
# blobs remain byte-opaque under the blanket rules above and are not normalized.
.gitattributes text eol=lf
liris/**/*.hbp text eol=lf
liris/**/*.md text eol=lf
liris/**/*.sha256 text eol=lf
receipts/LIRIS-*.hbp text eol=lf
receipts/LIRIS-*.sha256 text eol=lf
receipts/LIRIS-*.txt text eol=lf
gguf/liris/**/*.sha256 text eol=lf
spheres/liris-function64/**/*.sha256 text eol=lf

*-PUMPED.gguf filter=lfs diff=lfs merge=lfs -text
KIMI-K3-STAR-256.gguf filter=lfs diff=lfs merge=lfs -text
gguf/liris/star-shell-v4/*-FULL.gguf filter=lfs diff=lfs merge=lfs -text
